3.2  The Hash-Based Router — How Navigation Works
The router is the core engine of the SPA. It reads the URL hash, maps it to a page function, injects the result into the DOM, and runs per-page initialisation scripts. The entire site feels like a multi-page website but is actually a single file.

Request Flow — Step by Step
User clicks a nav link: <a data-page='slots'>Slots</a>
Document-level click delegation fires: document.addEventListener('click', e => { if (e.target.dataset.page) render(e.target.dataset.page) })
render('slots') is called — it calls PAGES['slots']() which returns a full HTML string
The string is injected into the page container: document.getElementById('page-content').innerHTML = html
initPage('slots') runs any page-specific JS (e.g. slot game filter, FAQ accordion init)
window.location.hash = 'slots' — the browser URL updates without a page reload
window.scrollTo(0,0) scrolls the user back to the top of the page

// Router pattern — core functions
function getPage() {
  const h = location.hash.replace('#','') || 'home';
  return PAGES[h] ? h : 'home';
}


function render(page) {
  document.getElementById('page-content').innerHTML = PAGES[page]();
  initPage(page);
  window.location.hash = page;
  window.scrollTo(0, 0);
}


// Click delegation — handles all data-page links
document.addEventListener('click', e => {
  const pg = e.target.closest('[data-page]');
  if (pg) { e.preventDefault(); render(pg.dataset.page); }
});


// Hash change (browser back/forward)
window.addEventListener('hashchange', () => render(getPage()));
document.addEventListener('DOMContentLoaded', () => render(getPage()));

